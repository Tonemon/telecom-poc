@@ -428,6 +434,13 @@ bool nas::connection_request_completed(bool outcome)
     }
   } else {
     logger.debug("RRC connection request failed. NAS State %s.", state.get_full_state_text().c_str());
+    if (state.get_state() == emm_state_t::state_t::registered && t3412_s > 0) {
+      // TS 24.301 5.5.3.2.6 b): a TAU whose connection could not be set up (lower layer failure)
